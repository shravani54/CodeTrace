<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CodeTrace.Student.Views.ExamSessionView">

    <Grid RowDefinitions="Auto,*" Margin="30">

        <Border Grid.Row="0" Classes="listCard" Margin="0,0,0,20">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock x:Name="ExamNameText" Classes="pageTitle" FontSize="22"/>
                    <TextBlock x:Name="StudentNameText" Classes="pageSubtitle"/>
                </StackPanel>
                <Border Grid.Column="1" Classes="chip" VerticalAlignment="Center">
                    <TextBlock x:Name="TimerText" Text="60:00"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="300,*" ColumnSpacing="20">

            <Border Grid.Column="0" Classes="card" VerticalAlignment="Top">
                <StackPanel Spacing="10">
                    <TextBlock Text="Allowed IDEs" Classes="fieldLabel"/>
                    <TextBlock Text="Launch one of the IDEs below to write your code."
                               Classes="pageSubtitle" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <StackPanel x:Name="IDEButtonsPanel" Spacing="8"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Classes="card" VerticalAlignment="Top">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="StatusText" FontSize="13" TextWrapping="Wrap"/>
                    <Button x:Name="SubmitButton" Content="Submit Examination"
                            Classes="primary" HorizontalAlignment="Left"
                            Click="SubmitButton_Click"/>
                </StackPanel>
            </Border>

        </Grid>

    </Grid>

</UserControl>