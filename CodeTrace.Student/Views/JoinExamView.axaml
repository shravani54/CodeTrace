<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CodeTrace.Student.Views.JoinExamView">

    <Grid>
        <Border Width="480" HorizontalAlignment="Center" VerticalAlignment="Center"
                Classes="card" Padding="36">
            <StackPanel Spacing="6">

                <Border Background="{DynamicResource AccentBrush}" Width="52" Height="52"
                        CornerRadius="14" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <TextBlock Text="CT" Foreground="White" FontWeight="Bold" FontSize="18"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="CodeTrace" FontSize="24" FontWeight="Bold"
                           Foreground="{DynamicResource HeadingText}" HorizontalAlignment="Center"/>
                <TextBlock Text="Join an examination" Classes="pageSubtitle"
                           HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <TextBlock Text="Full Name" Classes="fieldLabel" Margin="0,6,0,4"/>
                <TextBox x:Name="NameBox" Height="42" MaxLength="60"
                         PlaceholderText="e.g. Prathamesh Patil"/>

                <TextBlock Text="Roll Number" Classes="fieldLabel" Margin="0,12,0,4"/>
                <TextBox x:Name="RollBox" Height="42" MaxLength="10"
                         PlaceholderText="e.g. 2024045 (digits only)"/>

                <TextBlock Text="Select Examination" Classes="fieldLabel" Margin="0,12,0,4"/>
                <ComboBox x:Name="ExamComboBox" Height="42" HorizontalAlignment="Stretch"/>

                <TextBlock x:Name="StatusText" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0"/>

                <Button x:Name="JoinButton" Content="Join Examination" Classes="primary"
                        HorizontalAlignment="Stretch" Height="44" Margin="0,16,0,0"
                        Click="JoinButton_Click"/>

            </StackPanel>
        </Border>
    </Grid>

</UserControl>