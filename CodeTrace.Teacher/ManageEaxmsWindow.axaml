<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CodeTrace.Teacher.ManageExamsWindow"
        Title="Manage Examinations"
        Width="800"
        Height="500">

    <StackPanel Margin="30" Spacing="15">

        <TextBlock Text="Manage Examinations"
                   FontSize="28"
                   FontWeight="Bold"/>

        <ListBox x:Name="ExamListBox"
                 Height="300"/>

        <Button Content="Refresh"
                Width="120"
                Click="RefreshButton_Click"/>

    </StackPanel>

</Window>