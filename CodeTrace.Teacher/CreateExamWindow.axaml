<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CodeTrace.Teacher.CreateExamWindow"
        Title="Create Examination"
        Width="700"
        Height="600"
        WindowStartupLocation="CenterScreen">

    <StackPanel Margin="40" Spacing="15">

        <TextBlock Text="Create Examination"
                   FontSize="28"
                   FontWeight="Bold"/>

        <TextBlock Text="Examination Name"/>

        <TextBox Name="ExamNameBox"
                 Watermark="Enter examination name"/>

        <TextBlock Text="Duration (minutes)"
                   Margin="0,10,0,0"/>

        <NumericUpDown Name="DurationBox"
                       Minimum="1"
                       Maximum="300"
                       Value="60"/>

        <TextBlock Text="Description"
                   Margin="0,10,0,0"/>

        <TextBox Name="DescriptionBox"
                 Watermark="Enter examination description"
                 AcceptsReturn="True"
                 Height="100"/>

        <Button Content="Create Examination"
                Width="200"
                HorizontalAlignment="Center"
                Margin="0,20,0,0"
                Click="CreateExamButton_Click"/>

        <TextBlock Name="StatusText"
                   HorizontalAlignment="Center"/>

    </StackPanel>

</Window>