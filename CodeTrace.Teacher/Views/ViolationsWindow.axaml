<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="using:CodeTrace.Teacher.Models"
        x:Class="CodeTrace.Teacher.Views.ViolationsWindow"
        Title="Live violations"
        Width="900" Height="500"
        MinWidth="720" MinHeight="360"
        Background="#F0F9FF"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>

    <!-- LIST -->

    <Style Selector="ListBox#ViolationList">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
    </Style>

    <Style Selector="ListBox#ViolationList ListBoxItem">
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Foreground" Value="#0F172A"/>
    </Style>

    <Style Selector="ListBox#ViolationList ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#F0F9FF"/>
      <Setter Property="Foreground" Value="#0F172A"/>
    </Style>

    <Style Selector="ListBox#ViolationList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#E0F2FE"/>
      <Setter Property="Foreground" Value="#0C4A6E"/>
    </Style>

    <Style Selector="ListBox#ViolationList ListBoxItem TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- TABLE HEADER -->

    <Style Selector="TextBlock.colHeader">
      <Setter Property="Foreground" Value="#64748B"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>

  </Window.Styles>

  <Grid ClipToBounds="True" Background="#F0F9FF">

    <!-- Background lighting -->
    <Grid IsHitTestVisible="False">
      <Ellipse Width="560" Height="560"
               HorizontalAlignment="Right" VerticalAlignment="Top"
               Margin="0,-320,-170,0" Fill="#BAE6FD" Opacity="0.55"/>
      <Ellipse Width="500" Height="420"
               HorizontalAlignment="Left" VerticalAlignment="Bottom"
               Margin="-300,0,0,-260" Fill="#E0F2FE" Opacity="0.9"/>
    </Grid>

    <DockPanel Margin="28,24,28,24">

      <!-- HEADER -->

      <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18" Spacing="6">

        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Live" FontSize="28" FontWeight="Bold" Foreground="#0C4A6E"/>
          <TextBlock Text="Violations" FontSize="28" FontWeight="Bold" Foreground="#0284C7"/>
        </StackPanel>

        <TextBlock Name="StatusText" FontWeight="SemiBold" Foreground="#475569"/>

        <Border Height="1" Background="#BAE6FD" Margin="0,8,0,0"/>

      </StackPanel>

      <!-- TABLE -->

      <Border Background="#FFFFFF"
              BorderBrush="#BAE6FD"
              BorderThickness="1"
              CornerRadius="20"
              Padding="20"
              BoxShadow="0 16 44 0 #260EA5E9">

        <DockPanel>

          <StackPanel DockPanel.Dock="Top"
                      Orientation="Horizontal"
                      Spacing="16"
                      Margin="12,4,12,10">
            <TextBlock Text="Time" Width="70" Classes="colHeader"/>
            <TextBlock Text="Student" Width="160" Classes="colHeader"/>
            <TextBlock Text="Roll No." Width="80" Classes="colHeader"/>
            <TextBlock Text="Type" Width="140" Classes="colHeader"/>
            <TextBlock Text="Detail" Classes="colHeader"/>
          </StackPanel>

          <Border DockPanel.Dock="Top" Height="1" Background="#BAE6FD" Margin="0,0,0,6"/>

          <ListBox Name="ViolationList">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="m:Violation">
                <StackPanel Orientation="Horizontal" Spacing="16">
                  <TextBlock Text="{Binding TimeLocal}" Width="70" Foreground="#64748B"/>
                  <TextBlock Text="{Binding StudentName}" Width="160" Foreground="#0C4A6E" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding RollNumber}" Width="80" Foreground="#0F172A"/>
                  <TextBlock Text="{Binding Type}" Width="140" FontWeight="SemiBold" Foreground="#BE123C"/>
                  <TextBlock Text="{Binding Detail}" Foreground="#475569"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

        </DockPanel>

      </Border>

    </DockPanel>

  </Grid>

</Window>