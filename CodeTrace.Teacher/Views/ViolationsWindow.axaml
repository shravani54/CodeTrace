<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="using:CodeTrace.Teacher.Models"
        x:Class="CodeTrace.Teacher.Views.ViolationsWindow"
        Title="Live violations"
        Width="900" Height="500"
        MinWidth="720" MinHeight="360"
        Background="#070B1F"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>

    <!-- LIST -->

    <Style Selector="ListBox#ViolationList">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
    </Style>

    <Style Selector="ListBox#ViolationList ListBoxItem">
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Foreground" Value="#E8EDFF"/>
    </Style>

    <Style Selector="ListBox#ViolationList ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#101846"/>
      <Setter Property="Foreground" Value="#E8EDFF"/>
    </Style>

    <Style Selector="ListBox#ViolationList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#16205A"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style Selector="ListBox#ViolationList ListBoxItem TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- TABLE HEADER -->

    <Style Selector="TextBlock.colHeader">
      <Setter Property="Foreground" Value="#7F8BC4"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>

  </Window.Styles>

  <Grid>

    <!-- Decorative circles, same as the home page -->

    <Ellipse Width="460" Height="460" Fill="#0B1233"
             HorizontalAlignment="Right" VerticalAlignment="Top"
             Margin="0,-200,-160,0" IsHitTestVisible="False"/>

    <Ellipse Width="420" Height="420" Fill="#091029"
             HorizontalAlignment="Left" VerticalAlignment="Bottom"
             Margin="120,0,0,-260" IsHitTestVisible="False"/>

    <DockPanel Margin="28,24,28,24">

      <!-- HEADER -->

      <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18" Spacing="6">

        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Live" FontSize="28" FontWeight="Bold" Foreground="White"/>
          <TextBlock Text="Violations" FontSize="28" FontWeight="Bold" Foreground="#4F7BFF"/>
        </StackPanel>

        <TextBlock Name="StatusText" FontWeight="SemiBold" Foreground="#98A4D6"/>

      </StackPanel>

      <!-- TABLE -->

      <Border Background="#0D1330"
              BorderBrush="#1E2A63"
              BorderThickness="1"
              CornerRadius="18"
              Padding="16">

        <DockPanel>

          <StackPanel DockPanel.Dock="Top"
                      Orientation="Horizontal"
                      Spacing="16"
                      Margin="12,4,12,10">
            <TextBlock Text="Time" Width="70" Classes="colHeader"/>
            <TextBlock Text="Student" Width="160" Classes="colHeader"/>
            <TextBlock Text="Roll No." Width="80" Classes="colHeader"/>
            <TextBlock Text="Type" Width="140" Classes="colHeader"/>
            <TextBlock Text="Detail" Classes="colHeader"/>
          </StackPanel>

          <Border DockPanel.Dock="Top" Height="1" Background="#1E2A63" Margin="0,0,0,6"/>

          <ListBox Name="ViolationList">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="m:Violation">
                <StackPanel Orientation="Horizontal" Spacing="16">
                  <TextBlock Text="{Binding TimeLocal}" Width="70" Foreground="#98A4D6"/>
                  <TextBlock Text="{Binding StudentName}" Width="160" Foreground="White"/>
                  <TextBlock Text="{Binding RollNumber}" Width="80" Foreground="#E8EDFF"/>
                  <TextBlock Text="{Binding Type}" Width="140" FontWeight="SemiBold" Foreground="#FF9FB0"/>
                  <TextBlock Text="{Binding Detail}" Foreground="#C9D2FF"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

        </DockPanel>

      </Border>

    </DockPanel>

  </Grid>

</Window>