<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CodeTrace.Teacher.Views.JoinRequestsView"
             Background="#F0F9FF"
             ClipToBounds="True">

    <UserControl.Styles>

        <!-- Page header -->
        <Style Selector="TextBlock.page-title">
            <Setter Property="FontSize" Value="34"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#0C4A6E"/>
        </Style>
        <Style Selector="TextBlock.page-subtitle">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#475569"/>
        </Style>

        <!-- Empty state -->
        <Style Selector="TextBlock#EmptyText">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,48,0,0"/>
        </Style>

        <!-- Request rows (anything added to RequestPanel in code-behind) -->
        <Style Selector="StackPanel#RequestPanel > Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#BAE6FD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="22,18"/>
            <Setter Property="BoxShadow" Value="0 8 24 0 #190EA5E9"/>
        </Style>
        <Style Selector="StackPanel#RequestPanel > Border:pointerover">
            <Setter Property="BorderBrush" Value="#0EA5E9"/>
        </Style>
        <Style Selector="StackPanel#RequestPanel TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0C4A6E"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Buttons inside rows -->
        <Style Selector="StackPanel#RequestPanel Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#38BDF8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20,9"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="StackPanel#RequestPanel Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E0F2FE"/>
            <Setter Property="BorderBrush" Value="#0EA5E9"/>
        </Style>

        <!-- Button text (keeps button labels from picking up the row text style) -->
        <Style Selector="StackPanel#RequestPanel Button TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0369A1"/>
        </Style>

        <!-- Optional: add Classes "approve" / "reject" to the buttons in code-behind -->
        <Style Selector="StackPanel#RequestPanel Button.approve">
            <Setter Property="Background" Value="#12B76A"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="StackPanel#RequestPanel Button.approve:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#0E9F5C"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="StackPanel#RequestPanel Button.approve TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="StackPanel#RequestPanel Button.reject">
            <Setter Property="Background" Value="#FEF2F2"/>
            <Setter Property="BorderBrush" Value="#FCA5A5"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="StackPanel#RequestPanel Button.reject:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FEE2E2"/>
            <Setter Property="BorderBrush" Value="#F87171"/>
        </Style>
        <Style Selector="StackPanel#RequestPanel Button.reject TextBlock">
            <Setter Property="Foreground" Value="#B91C1C"/>
        </Style>

    </UserControl.Styles>

    <Grid>

        <!-- Decorative circles, same as SignUp -->
        <Ellipse Width="560" Height="560" Fill="#BAE6FD" Opacity="0.55"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-320,-170,0" IsHitTestVisible="False"/>

        <Ellipse Width="500" Height="420" Fill="#E0F2FE" Opacity="0.9"
                 HorizontalAlignment="Left" VerticalAlignment="Bottom"
                 Margin="-300,0,0,-260" IsHitTestVisible="False"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="36,32,36,36" Spacing="16" MaxWidth="1000" HorizontalAlignment="Stretch">

                <StackPanel Spacing="6" Margin="0,0,0,8">

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Join" Classes="page-title"/>
                        <TextBlock Text="Requests" Classes="page-title" Foreground="#0369A1"/>
                    </StackPanel>

                    <TextBlock Text="Students waiting to join your examinations. Approve to let them in."
                               Classes="page-subtitle"/>

                </StackPanel>

                <TextBlock x:Name="EmptyText" Text="No pending requests." Opacity="0.7"/>
                <StackPanel x:Name="RequestPanel" Spacing="12"/>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>