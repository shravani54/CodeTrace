<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CodeTrace.Teacher.Views.JoinRequestsView"
             Background="#070B1F"
             ClipToBounds="True">

    <UserControl.Styles>

        <!-- Page header -->
        <Style Selector="TextBlock.page-title">
            <Setter Property="FontSize" Value="34"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="TextBlock.page-subtitle">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#98A4D6"/>
        </Style>

        <!-- Empty state -->
        <Style Selector="TextBlock#EmptyText">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#98A4D6"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,48,0,0"/>
        </Style>

        <!-- Request rows (anything added to RequestPanel in code-behind) -->
        <Style Selector="StackPanel#RequestPanel > Border">
            <Setter Property="Background" Value="#0D1330"/>
            <Setter Property="BorderBrush" Value="#1E2A63"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="22,18"/>
        </Style>
        <Style Selector="StackPanel#RequestPanel > Border:pointerover">
            <Setter Property="BorderBrush" Value="#3B6CF5"/>
        </Style>
        <Style Selector="StackPanel#RequestPanel TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Buttons inside rows -->
        <Style Selector="StackPanel#RequestPanel Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#3B6CF5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20,9"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="StackPanel#RequestPanel Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#131B4A"/>
            <Setter Property="BorderBrush" Value="#3B6CF5"/>
        </Style>

        <!-- Button text (keeps button labels from picking up the row text style) -->
        <Style Selector="StackPanel#RequestPanel Button TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#9DB6FF"/>
        </Style>

        <!-- Optional: add Classes "approve" / "reject" to the buttons in code-behind -->
        <Style Selector="StackPanel#RequestPanel Button.approve">
            <Setter Property="Background" Value="#12B76A"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="StackPanel#RequestPanel Button.approve:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#0E9F5C"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="StackPanel#RequestPanel Button.approve TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="StackPanel#RequestPanel Button.reject">
            <Setter Property="Background" Value="#22101F"/>
            <Setter Property="BorderBrush" Value="#5A2038"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="StackPanel#RequestPanel Button.reject:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#34162B"/>
            <Setter Property="BorderBrush" Value="#5A2038"/>
        </Style>
        <Style Selector="StackPanel#RequestPanel Button.reject TextBlock">
            <Setter Property="Foreground" Value="#FF9FB0"/>
        </Style>

    </UserControl.Styles>

    <Grid>

        <!-- Decorative circles, same as the home page -->

        <Ellipse Width="460" Height="460" Fill="#0B1233"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-200,-160,0" IsHitTestVisible="False"/>

        <Ellipse Width="420" Height="420" Fill="#091029"
                 HorizontalAlignment="Left" VerticalAlignment="Bottom"
                 Margin="120,0,0,-260" IsHitTestVisible="False"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="36,32,36,36" Spacing="16" MaxWidth="1000" HorizontalAlignment="Stretch">

                <StackPanel Spacing="6" Margin="0,0,0,8">

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Join" Classes="page-title"/>
                        <TextBlock Text="Requests" Classes="page-title" Foreground="#4F7BFF"/>
                    </StackPanel>

                    <TextBlock Text="Students waiting to join your examinations. Approve to let them in."
                               Classes="page-subtitle"/>

                </StackPanel>

                <TextBlock x:Name="EmptyText" Text="No pending requests." Opacity="0.7"/>
                <StackPanel x:Name="RequestPanel" Spacing="12"/>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>