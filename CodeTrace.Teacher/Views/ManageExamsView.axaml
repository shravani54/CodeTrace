<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CodeTrace.Teacher.Views.ManageExamsView">

  <UserControl.Resources>
    <SolidColorBrush x:Key="LoginMutedText" Color="#475569"/>
    <SolidColorBrush x:Key="LoginErrorText" Color="#BE123C"/>
  </UserControl.Resources>

  <UserControl.Styles>

    <Style Selector="TextBlock.pageTitle">
      <Setter Property="FontSize" Value="34"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="#0C4A6E"/>
    </Style>

    <Style Selector="TextBlock.pageSubtitle">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="#475569"/>
    </Style>

    <Style Selector="ProgressBar">
      <Setter Property="Foreground" Value="#0EA5E9"/>
      <Setter Property="Background" Value="#E0F2FE"/>
    </Style>

    <!-- Exam cards (built in code into ExamListPanel): readable dark text -->
    <Style Selector="StackPanel#ExamListPanel TextBlock">
      <Setter Property="Foreground" Value="#0F172A"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>

  </UserControl.Styles>

  <Grid ClipToBounds="True" Background="#F0F9FF">

    <!-- Background lighting -->
    <Grid IsHitTestVisible="False">
      <Ellipse Width="560" Height="560"
               HorizontalAlignment="Right" VerticalAlignment="Top"
               Margin="0,-320,-170,0" Fill="#BAE6FD" Opacity="0.55"/>
      <Ellipse Width="500" Height="420"
               HorizontalAlignment="Left" VerticalAlignment="Bottom"
               Margin="-300,0,0,-260" Fill="#E0F2FE" Opacity="0.9"/>
    </Grid>

    <Grid RowDefinitions="Auto,Auto,*"
          Margin="36,32,36,36"
          MaxWidth="1000"
          HorizontalAlignment="Stretch">

      <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,24">

        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="Manage" Classes="pageTitle"/>
          <TextBlock Text="Examinations" Classes="pageTitle" Foreground="#0284C7"/>
        </StackPanel>

        <TextBlock Text="View, edit, and remove examinations you've created."
                   Classes="pageSubtitle"/>

        <Border Height="1" Background="#BAE6FD" Margin="0,14,0,0"/>

      </StackPanel>

      <ProgressBar Grid.Row="1"
                   x:Name="LoadingBar"
                   IsIndeterminate="True"
                   IsVisible="False"
                   Height="3"
                   Margin="0,0,0,16"/>

      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="ExamListPanel" Spacing="14"/>
      </ScrollViewer>

    </Grid>

  </Grid>
</UserControl>