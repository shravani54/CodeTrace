<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="CodeTrace.Teacher.Views.ManageIDEsView">

    <UserControl.Styles>

        <StyleInclude Source="/Styles/CodeTraceDark.axaml"/>

        <Style Selector="TextBlock.pageTitle">
            <Setter Property="FontSize" Value="34"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="TextBlock.pageSubtitle">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#98A4D6"/>
        </Style>

        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="20"/>
        </Style>

        <Style Selector="ProgressBar">
            <Setter Property="Foreground" Value="#4F7BFF"/>
            <Setter Property="Background" Value="#131B4A"/>
        </Style>

        <!-- The page's Add IDE button is wider than the one in the dialogs -->

        <Style Selector="Button#AddIDEButton">
            <Setter Property="Height" Value="50"/>
            <Setter Property="MinWidth" Value="230"/>
        </Style>

    </UserControl.Styles>

    <Border Background="#070B1F" ClipToBounds="True">

        <Grid>

            <!-- Decorative circles, same as the home page -->

            <Ellipse Width="460" Height="460" Fill="#0B1233"
                     HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,-200,-160,0" IsHitTestVisible="False"/>

            <Ellipse Width="420" Height="420" Fill="#091029"
                     HorizontalAlignment="Left" VerticalAlignment="Bottom"
                     Margin="120,0,0,-260" IsHitTestVisible="False"/>

            <ScrollViewer>

                <StackPanel Margin="36,32,36,36" MaxWidth="1000" HorizontalAlignment="Stretch">

                    <!-- HEADER -->

                    <StackPanel Margin="0,0,0,24">

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="Manage" Classes="pageTitle"/>
                            <TextBlock Text="IDEs" Classes="pageTitle" Foreground="#4F7BFF"/>
                        </StackPanel>

                        <TextBlock Text="Add and manage IDEs that can be assigned to examinations."
                                   Classes="pageSubtitle"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"/>

                    </StackPanel>

                    <!-- MAIN CARD -->

                    <Border Classes="card">

                        <StackPanel>

                            <TextBlock Text="Available IDEs" Classes="sectionTitle"/>

                            <TextBlock Text="These IDEs can be allowed when you create an examination."
                                       Classes="pageSubtitle"
                                       Margin="0,4,0,0"/>

                            <ProgressBar x:Name="LoadingBar"
                                         IsIndeterminate="True"
                                         IsVisible="False"
                                         Height="4"
                                         Margin="0,14,0,0"/>

                            <!-- Dynamic IDE list -->

                            <StackPanel x:Name="IDEListPanel"
                                        Spacing="12"
                                        Margin="0,18,0,0"/>

                            <!-- Divider -->

                            <Border Height="1" Background="#1E2A63" Margin="0,26,0,22"/>

                            <!-- Button -->

                            <Button x:Name="AddIDEButton"
                                    Classes="primary"
                                    Click="AddIDEButton_Click"
                                    HorizontalAlignment="Left">

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="+"/>
                                    <TextBlock Text="Add IDE"/>
                                </StackPanel>

                            </Button>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </ScrollViewer>

        </Grid>

    </Border>

</UserControl>