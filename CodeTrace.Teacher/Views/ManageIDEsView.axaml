<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CodeTrace.Teacher.Views.ManageIDEsView">

    <Grid RowDefinitions="Auto,*"
          Margin="30">

        <StackPanel Grid.Row="0"
                    Spacing="10">

            <TextBlock Text="Manage IDEs"
                       FontSize="30"
                       FontWeight="Bold"/>

            <TextBlock Text="Add and manage IDEs that can be assigned to examinations."
                       TextWrapping="Wrap"/>

            <Button Content="Add IDE"
                    Width="130"
                    HorizontalAlignment="Left"
                    Margin="0,10,0,20"
                    Click="AddIDEButton_Click"/>

        </StackPanel>

        <ScrollViewer Grid.Row="1">

            <StackPanel x:Name="IDEListPanel"
                        Spacing="10"/>

        </ScrollViewer>

    </Grid>

</UserControl>