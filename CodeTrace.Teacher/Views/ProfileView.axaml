<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CodeTrace.Teacher.Views.ProfileView"
             ClipToBounds="True">

  <UserControl.Styles>

    <Style Selector="TextBlock.pageTitle">
      <Setter Property="FontSize" Value="34"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="#0C4A6E"/>
    </Style>

    <Style Selector="TextBlock.pageSubtitle">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="#475569"/>
    </Style>

    <Style Selector="TextBlock.fieldLabel">
      <Setter Property="Foreground" Value="#64748B"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.fieldValue">
      <Setter Property="Foreground" Value="#0F172A"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#BAE6FD"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="20"/>
      <Setter Property="Padding" Value="32"/>
      <Setter Property="BoxShadow" Value="0 16 44 0 #260EA5E9"/>
    </Style>

    <Style Selector="Border.divider">
      <Setter Property="Height" Value="1"/>
      <Setter Property="Background" Value="#BAE6FD"/>
      <Setter Property="Margin" Value="0,20"/>
    </Style>

  </UserControl.Styles>

  <Grid ClipToBounds="True" Background="#F0F9FF">

    <!-- Background lighting -->
    <Grid IsHitTestVisible="False">
      <Ellipse Width="560" Height="560"
               HorizontalAlignment="Right" VerticalAlignment="Top"
               Margin="0,-320,-170,0" Fill="#BAE6FD" Opacity="0.55"/>
      <Ellipse Width="500" Height="420"
               HorizontalAlignment="Left" VerticalAlignment="Bottom"
               Margin="-300,0,0,-260" Fill="#E0F2FE" Opacity="0.9"/>
    </Grid>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

      <StackPanel Margin="36,32,36,36" MaxWidth="1000" HorizontalAlignment="Stretch">

        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="Your" Classes="pageTitle"/>
          <TextBlock Text="Profile" Classes="pageTitle" Foreground="#0284C7"/>
        </StackPanel>

        <TextBlock Text="Your account details."
                   Classes="pageSubtitle"
                   Margin="0,6,0,14"/>

        <Border Height="1" Background="#BAE6FD" Margin="0,0,0,24"/>

        <Border Classes="card">

          <StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="18">

              <Border Width="64" Height="64" CornerRadius="32" Background="#0369A1">
                <TextBlock x:Name="InitialText"
                           Text="T"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
              </Border>

              <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Name="UsernameText"
                           Text="teacher"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#0C4A6E"/>
                <TextBlock Text="Signed in" Classes="pageSubtitle"/>
              </StackPanel>

            </StackPanel>

            <Border Classes="divider"/>

            <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto" RowSpacing="16">

              <TextBlock Text="Username" Classes="fieldLabel"/>
              <TextBlock x:Name="UsernameDetailText"
                         Grid.Column="1"
                         Text="teacher"
                         Classes="fieldValue"/>

              <TextBlock Grid.Row="1" Text="Role" Classes="fieldLabel"/>
              <TextBlock Grid.Row="1" Grid.Column="1" Text="Teacher" Classes="fieldValue"/>

            </Grid>

          </StackPanel>

        </Border>

      </StackPanel>

    </ScrollViewer>

  </Grid>
</UserControl>