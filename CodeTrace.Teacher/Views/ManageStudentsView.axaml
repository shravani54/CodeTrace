<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CodeTrace.Teacher.Views.ManageStudentsView"
             ClipToBounds="True">

  <UserControl.Styles>

    <!-- DEFAULT: any text without its own color is dark and readable -->
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="#0F172A"/>
    </Style>

    <!-- TEXT -->

    <Style Selector="TextBlock.pageTitle">
      <Setter Property="FontSize" Value="34"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="#0C4A6E"/>
    </Style>

    <Style Selector="TextBlock.pageSubtitle">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Foreground" Value="#475569"/>
    </Style>

    <Style Selector="TextBlock.fieldLabel">
      <Setter Property="Foreground" Value="#0C4A6E"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="15"/>
    </Style>

    <!-- CARD + DIVIDER -->

    <Style Selector="Border.card">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#BAE6FD"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="20"/>
      <Setter Property="Padding" Value="32"/>
      <Setter Property="BoxShadow" Value="0 16 44 0 #260EA5E9"/>
    </Style>

    <Style Selector="Border.divider">
      <Setter Property="Height" Value="1"/>
      <Setter Property="Background" Value="#BAE6FD"/>
      <Setter Property="Margin" Value="0,4"/>
    </Style>

    <!-- EXAM CARDS (built in code into ExamsPanel) -->

    <Style Selector="Button.examCard">
      <Setter Property="Background" Value="#F0F9FF"/>
      <Setter Property="BorderBrush" Value="#7DD3FC"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="20,16"/>
      <Setter Property="Foreground" Value="#0C4A6E"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Button.examCard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#E0F2FE"/>
      <Setter Property="BorderBrush" Value="#0EA5E9"/>
      <Setter Property="Foreground" Value="#0C4A6E"/>
    </Style>

    <!-- Text inside exam cards: bold dark title, readable secondary text -->
    <Style Selector="Button.examCard TextBlock">
      <Setter Property="Foreground" Value="#334155"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="Medium"/>
    </Style>

    <Style Selector="Button.examCard TextBlock.examName">
      <Setter Property="Foreground" Value="#0C4A6E"/>
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- BACK BUTTON -->

    <Style Selector="Button#BackButton">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="#0369A1"/>
      <Setter Property="BorderBrush" Value="#7DD3FC"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Button#BackButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#E0F2FE"/>
      <Setter Property="BorderBrush" Value="#0EA5E9"/>
      <Setter Property="Foreground" Value="#0C4A6E"/>
    </Style>

    <!-- CLEAR BUTTON -->

    <Style Selector="Button#ClearButton">
      <Setter Property="Background" Value="#FFF1F2"/>
      <Setter Property="Foreground" Value="#BE123C"/>
      <Setter Property="BorderBrush" Value="#FECDD3"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="18,8"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="Button#ClearButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FFE4E6"/>
      <Setter Property="BorderBrush" Value="#FDA4AF"/>
      <Setter Property="Foreground" Value="#9F1239"/>
    </Style>

    <!-- STUDENT ROWS (built in code into RowsPanel) -->

    <Style Selector="StackPanel#RowsPanel TextBlock">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Foreground" Value="#0F172A"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="StackPanel#RowsPanel > Grid">
      <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="StackPanel#RowsPanel > Grid:pointerover">
      <Setter Property="Background" Value="#F0F9FF"/>
    </Style>

    <Style Selector="StackPanel#RowsPanel > Border">
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="0,8"/>
    </Style>

    <Style Selector="StackPanel#RowsPanel > Border:pointerover">
      <Setter Property="Background" Value="#F0F9FF"/>
    </Style>

  </UserControl.Styles>

  <Grid ClipToBounds="True" Background="#F0F9FF">

    <!-- Background lighting -->
    <Grid IsHitTestVisible="False">
      <Ellipse Width="560" Height="560"
               HorizontalAlignment="Right" VerticalAlignment="Top"
               Margin="0,-320,-170,0" Fill="#BAE6FD" Opacity="0.55"/>
      <Ellipse Width="500" Height="420"
               HorizontalAlignment="Left" VerticalAlignment="Bottom"
               Margin="-300,0,0,-260" Fill="#E0F2FE" Opacity="0.9"/>
    </Grid>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

      <StackPanel Margin="36,32,36,36" MaxWidth="1000" HorizontalAlignment="Stretch">

        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="Manage" Classes="pageTitle"/>
          <TextBlock Text="Students" Classes="pageTitle" Foreground="#0284C7"/>
        </StackPanel>

        <TextBlock x:Name="SubtitleText"
                   Text="Pick an exam to see the students who joined it."
                   Classes="pageSubtitle"
                   Margin="0,6,0,14"/>

        <Border Height="1" Background="#BAE6FD" Margin="0,0,0,24"/>

        <Border Classes="card">

          <Grid>

            <!-- STEP 1: ongoing exams -->
            <StackPanel x:Name="ExamsSection" Spacing="12">

              <TextBlock x:Name="ExamsCountText" Classes="fieldLabel"/>

              <Border Classes="divider"/>

              <StackPanel x:Name="ExamsPanel" Spacing="10"/>

              <TextBlock x:Name="NoExamsText"
                         Text="No ongoing exams right now."
                         Classes="pageSubtitle"
                         IsVisible="False"/>

            </StackPanel>

            <!-- STEP 2: students of the selected exam -->
            <StackPanel x:Name="StudentsSection" Spacing="10" IsVisible="False">

              <Grid ColumnDefinitions="Auto,*,Auto">
                <Button x:Name="BackButton" Content="←  Back to exams"
                        Click="BackButton_Click"/>

                <StackPanel Grid.Column="1" Margin="20,0" VerticalAlignment="Center" Spacing="2">
                  <TextBlock x:Name="ExamTitleText" Classes="fieldLabel" FontSize="17"/>
                  <TextBlock x:Name="CountText" Classes="pageSubtitle"/>
                </StackPanel>

                <Button Grid.Column="2" x:Name="ClearButton" Content="Clear list"
                        Click="ClearButton_Click"/>
              </Grid>

              <!-- Table header -->
              <Grid ColumnDefinitions="50,*,140,180,110" Margin="8,8,8,0">
                <TextBlock Grid.Column="0" Text="No." Classes="fieldLabel" Foreground="#475569"/>
                <TextBlock Grid.Column="1" Text="Name" Classes="fieldLabel" Foreground="#475569"/>
                <TextBlock Grid.Column="2" Text="Roll Number" Classes="fieldLabel" Foreground="#475569"/>
                <TextBlock Grid.Column="3" Text="Status" Classes="fieldLabel" Foreground="#475569"/>
                <TextBlock Grid.Column="4" Text="Logged in" Classes="fieldLabel" Foreground="#475569"/>
              </Grid>

              <Border Classes="divider"/>

              <StackPanel x:Name="RowsPanel" Spacing="2"/>

              <TextBlock x:Name="EmptyText"
                         Text="No students have joined this exam yet."
                         Classes="pageSubtitle"
                         IsVisible="False"/>

            </StackPanel>

          </Grid>

        </Border>

        <TextBlock x:Name="ErrorText"
                   Text="Cannot reach the server."
                   Foreground="#BE123C"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Margin="0,12,0,0"
                   IsVisible="False"/>

      </StackPanel>

    </ScrollViewer>

  </Grid>
</UserControl>